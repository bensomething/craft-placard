{# Social Image field input. The preview follows unsaved edits to the dropdown and the fields it points at. #}
{% import '_includes/forms' as forms %}
{% set rootId = field.handle ~ '-placard-si' %}

<div id="{{ rootId }}" class="placard-si"
     data-card-url="{{ cardUrl }}">
    {% if imageUrl %}
        <div class="placard-si__preview">
            {# Shown for Custom Image with nothing chosen, instead of the fallback card. #}
            {{ include('placard/_preview/cards', {
                imageUrl: imageUrl,
                placeholder: tag('div', { class: 'cp-icon', html: iconSvg('hexagon-image'), 'aria-hidden': 'true' }),
            }, with_context = false) }}
        </div>
    {% else %}
        <p class="light">{{ 'Save the entry to preview how it will appear when shared.'|t('placard') }}</p>
    {% endif %}

    <div class="placard-si__controls">
        {# Hidden, not removed, with one option, so the value still posts. #}
        <div class="placard-si__source{{ options|filter(o => o.value is defined)|length < 2 ? ' hidden' }}">
            {{ forms.select({
                id: field.handle ~ '-source',
                name: field.handle ~ '[source]',
                options: options,
                value: value.source,
            }) }}
        </div>

        {# Styles only change the card, so this shows while the card is what's shared (see update()). #}
        {% if styleOptions %}
            <div class="placard-si__style{{ value.source != 'card' ? ' hidden' }}">
                {{ forms.select({
                    id: field.handle ~ '-style',
                    name: field.handle ~ '[style]',
                    options: styleOptions,
                    value: value.style ?? '',
                    inputAttributes: { aria: { label: 'Style'|t('placard') } },
                }) }}
            </div>
        {% endif %}

        <div class="placard-si__custom{{ value.source != 'custom' ? ' hidden' }}">
            {{ forms.elementSelect({
                id: field.handle ~ '-asset',
                name: field.handle ~ '[assetId]',
                elementType: 'craft\\elements\\Asset',
                elements: asset ? [asset] : [],
                limit: 1,
                criteria: { kind: ['image'] },
                selectionLabel: 'Choose an image'|t('placard'),
            }) }}
        </div>
    </div>
</div>

<style>
    .placard-si { display: flex; flex-direction: column; gap: 12px; }
    .placard-si__source .select, .placard-si__style .select { max-width: 100%; }
    .placard-si__controls { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
    .placard-si__controls > .hidden { display: none; }
    .placard-si__custom .elementselect { margin: 0; }
</style>

{% js %}
(function () {
    var root = document.getElementById({{ view.namespaceInputId(rootId)|json_encode|raw }});
    if (!root) return;

    var select = root.querySelector('.placard-si__source select');
    var custom = root.querySelector('.placard-si__custom');
    var style = root.querySelector('.placard-si__style');
    var preview = root.querySelector('.placard-sp');
    var img = root.querySelector('.placard-sp__img');
    var cardUrl = root.dataset.cardUrl;
    var form = root.closest('form') || document;
    var urls = {};
    var pending = 0;

    function selectedIn(handle) {
        var field = form.querySelector('.field[data-attribute="' + handle + '"]');
        var element = field && field.querySelector('.elements [data-id]');
        return element ? element.dataset.id : null;
    }

    // Asset id for the current choice, or null for the card. Mirrors Placard's share rule.
    function resolve() {
        var source = select.value;
        if (source === 'custom') {
            var picked = custom.querySelector('.elements [data-id]');
            return picked ? picked.dataset.id : null;
        }
        if (source.indexOf('field:') === 0) {
            return selectedIn(source.slice(6));
        }
        return null;
    }

    function show(url) {
        var loader = new Image();
        var request = ++pending;
        // Cards render on request, so the first view of one can take a while.
        preview.dataset.loading = url;
        preview.classList.add('is-loading');
        loader.onload = loader.onerror = function () {
            if (request !== pending) return;
            img.style.backgroundImage = "url('" + url + "')";
            img.dataset.url = url;
            preview.classList.remove('is-loading');
        };
        loader.src = url;
    }

    function isEmpty() {
        return select.value === 'custom' && !custom.querySelector('.elements [data-id]');
    }

    function update() {
        custom.classList.toggle('hidden', select.value !== 'custom');
        var assetId = resolve();
        if (style) style.classList.toggle('hidden', !!assetId || isEmpty());
        if (!img) return;

        preview.classList.toggle('is-empty', isEmpty());

        if (!assetId) {
            if (cardUrl) show(cardUrl);
            return;
        }
        if (urls[assetId]) {
            show(urls[assetId]);
            return;
        }
        Craft.sendActionRequest('GET', 'placard/image/asset-url', { params: { assetId: assetId } })
            .then(function (response) {
                urls[assetId] = response.data.url;
                if (resolve() === assetId) show(response.data.url);
            })
            .catch(function () {});
    }

    if (preview) preview.classList.toggle('is-empty', isEmpty());
    // An image field with nothing in it shares the card, so its style applies.
    if (style) style.classList.toggle('hidden', !!resolve() || isEmpty());
    select.addEventListener('change', update);

    // Watch the element lists, as picking or removing an image fires no change event.
    var observer = new MutationObserver(update);
    var watched = [custom].concat(Array.prototype.map.call(
        select.options,
        function (option) {
            return option.value.indexOf('field:') === 0 ? option.value.slice(6) : null;
        }
    ).filter(Boolean).map(function (handle) {
        return form.querySelector('.field[data-attribute="' + handle + '"]');
    }));
    watched.forEach(function (node) {
        if (node) observer.observe(node, { childList: true, subtree: true });
    });

    // The card only reflects edits once the draft saves, so refetch it then.
    // Bound on the class, as this form's editor may not exist yet.
    if (img && window.Craft && Craft.ElementEditor) {
        var onSave = function (ev) {
            var editor = ev.target;
            if (!document.body.contains(root)) {
                Garnish.off(Craft.ElementEditor, 'afterSaveDraft', onSave);
                return;
            }
            if (!editor.$container[0].contains(root)) return;
            Craft.sendActionRequest('GET', 'placard/image/card-url', {
                params: { entryId: editor.settings.elementId, siteId: editor.settings.siteId },
            })
                .then(function (response) {
                    // The URL is versioned by dateUpdated, to the second, so bust it per save.
                    cardUrl = response.data.url + '&t=' + Date.now();
                    update();
                })
                .catch(function () {});
        };
        Garnish.on(Craft.ElementEditor, 'afterSaveDraft', onSave);
    }
})();
{% endjs %}
