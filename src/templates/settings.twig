{# Herald plugin settings. Anything set in config/herald.php overrides these. #}
{% import "_includes/forms" as forms %}

<h2>Canvas</h2>

{{ forms.textField({
    label: 'Width',
    instructions: 'Card width in pixels.',
    id: 'width',
    name: 'width',
    value: settings.width,
    size: 6,
    type: 'number',
}) }}

{{ forms.textField({
    label: 'Height',
    instructions: 'Card height in pixels.',
    id: 'height',
    name: 'height',
    value: settings.height,
    size: 6,
    type: 'number',
}) }}

{{ forms.textField({
    label: 'Padding',
    instructions: 'Inner padding in pixels.',
    id: 'padding',
    name: 'padding',
    value: settings.padding,
    size: 6,
    type: 'number',
}) }}

<hr>
<h2>Title</h2>

{{ forms.textField({
    label: 'Title font size',
    id: 'titleFontSize',
    name: 'titleFontSize',
    value: settings.titleFontSize,
    size: 6,
    type: 'number',
}) }}

{{ forms.textField({
    label: 'Max lines',
    instructions: 'Titles longer than this are clamped with an ellipsis.',
    id: 'maxLines',
    name: 'maxLines',
    value: settings.maxLines,
    size: 6,
    type: 'number',
}) }}

{{ forms.lightswitchField({
    label: 'Uppercase title',
    id: 'uppercaseTitle',
    name: 'uppercaseTitle',
    on: settings.uppercaseTitle,
}) }}

<hr>
<h2>Palette</h2>

{{ forms.textField({ label: 'Background colour', id: 'backgroundColor', name: 'backgroundColor', value: settings.backgroundColor, size: 10 }) }}
{{ forms.textField({ label: 'Title colour', id: 'titleColor', name: 'titleColor', value: settings.titleColor, size: 10 }) }}
{{ forms.textField({ label: 'Label / date colour', id: 'metaColor', name: 'metaColor', value: settings.metaColor, size: 10 }) }}

<hr>
<h2>Assets</h2>

{{ forms.textField({
    label: 'Display font path',
    instructions: 'Absolute path or Craft alias to the title font. Leave blank to use the bundled Inter Bold. No commercial font ships with the plugin — point this at your own licensed display font.',
    id: 'displayFontPath',
    name: 'displayFontPath',
    value: settings.displayFontPath,
    placeholder: '@root/src/fonts/MyDisplay.otf',
}) }}

{{ forms.textField({
    label: 'Label font path',
    instructions: 'Defaults to bundled Inter Medium.',
    id: 'labelFontPath',
    name: 'labelFontPath',
    value: settings.labelFontPath,
}) }}

{{ forms.textField({
    label: 'Date font path',
    instructions: 'Defaults to bundled Inter Regular.',
    id: 'dateFontPath',
    name: 'dateFontPath',
    value: settings.dateFontPath,
}) }}

{{ forms.textField({
    label: 'Logo path',
    instructions: 'Absolute path or Craft alias to a PNG logo (top-left). Leave blank for no logo.',
    id: 'logoPath',
    name: 'logoPath',
    value: settings.logoPath,
    placeholder: '@webroot/img/logo.png',
}) }}

<hr>
<h2>Background &amp; fallback</h2>

{{ forms.lightswitchField({
    label: 'Use share image as background',
    instructions: 'Render the entry’s first share image faintly behind the card.',
    id: 'useImageAsBackground',
    name: 'useImageAsBackground',
    on: settings.useImageAsBackground,
}) }}

{{ forms.textField({
    label: 'Background opacity',
    instructions: '0–1.',
    id: 'backgroundOpacity',
    name: 'backgroundOpacity',
    value: settings.backgroundOpacity,
    size: 6,
}) }}

{{ forms.textField({
    label: 'Default image path',
    instructions: 'URL returned by craft.herald.default().',
    id: 'defaultImagePath',
    name: 'defaultImagePath',
    value: settings.defaultImagePath,
}) }}

<p class="light">Image field handles and other advanced options are best set in <code>config/herald.php</code>.</p>
