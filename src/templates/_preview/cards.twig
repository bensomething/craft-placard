{#
    Share preview: the card at its real aspect ratio, not a per-platform mock-up, as every
    platform crops differently. `is-showing-safe` on `.placard-sp` overlays the safe area, and
    `is-loading` covers the card with a spinner until the image arrives.

    Params:
      imageUrl     Image to frame. Defaults to the entry's share image.
      entry        Entry to resolve the image from when imageUrl is absent.
      maxWidth     Max width in px (default 480). false fills the container.
      placeholder  HTML shown instead of the card while `.placard-sp` has `is-empty`.
#}
{% set imageUrl = imageUrl ?? (entry ?? null ? craft.placard.shareImageUrl(entry) : null) %}

{% if imageUrl %}
    {% set placard = craft.app.plugins.getPlugin('placard') %}
    {% set cardWidth = placard ? placard.settings.width : 1200 %}
    {% set cardHeight = placard ? placard.settings.height : 630 %}
    {# Sits under the image to avoid a grey flash while loading. Config may omit the #. #}
    {% set cardBg = placard ? '#' ~ placard.settings.backgroundColor|trim('#') : '#000000' %}

    <div class="placard-sp is-loading" style="--placard-w: {{ cardWidth }}; --placard-h: {{ cardHeight }}; --placard-bg: {{ cardBg }}; --placard-max-w: {{ (maxWidth ?? 480) is same as(false) ? 'none' : (maxWidth ?? 480) ~ 'px' }}">
        {# `data-url` tracks the image on screen (the settings page swaps it) for the lightbox. #}
        <div class="placard-sp__frame button-fade">
            <div class="placard-sp__img" data-url="{{ imageUrl }}" style="background-image:url('{{ imageUrl }}')"></div>
            <div class="placard-sp__safe" aria-hidden="true"></div>
            {# Before the placeholder, so an empty Custom Image covers it. #}
            <div class="placard-sp__loading"><div class="spinner big" role="status" aria-label="{{ 'Loading'|t('app') }}"></div></div>
            {% if placeholder ?? false %}
                <div class="placard-sp__placeholder">{{ placeholder|raw }}</div>
            {% endif %}
            <div class="buttons">
                {# Not `preview-btn`: the entry editor binds that to Live Preview, so both would open. #}
                <button type="button" class="btn placard-sp__open" data-icon="view">{{ 'Preview'|t('app') }}</button>
            </div>
        </div>
    </div>

    <style>
        .placard-sp {
            max-width: var(--placard-max-w, 480px);
            /* The usual 1080×600 safe area of a 1200×630 card, as proportions so any size works. */
            --placard-safe-x: 5%;
            --placard-safe-y: 2.4%;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        .placard-sp__frame {
            position: relative;
            aspect-ratio: var(--placard-w) / var(--placard-h);
            border: 1px solid #d3d9e0; border-radius: 6px; overflow: hidden;
        }
        .placard-sp__img {
            position: absolute; inset: 0;
            background: var(--placard-bg, #e9ebee) center/cover no-repeat;
        }
        /* Shades the margin at risk. The huge spread fills it and the frame's overflow clips it. */
        .placard-sp__safe {
            position: absolute;
            inset: var(--placard-safe-y) var(--placard-safe-x);
            opacity: 0; transition: opacity .15s;
            box-shadow: 0 0 0 9999px rgba(0, 0, 0, .55);
            outline: 1px dashed rgba(255, 255, 255, .5);
        }
        .placard-sp.is-showing-safe .placard-sp__safe { opacity: 1; }

        .placard-sp__placeholder,
        .placard-sp__loading {
            position: absolute; inset: 0;
            display: none; align-items: center; justify-content: center;
            background: var(--gray-100, #e4e9f0); color: var(--gray-400, #7b8793);
        }
        /* Fades in after a beat, so a cached card doesn't flash it, and out at once. */
        .placard-sp__loading {
            display: flex;
            opacity: 0; visibility: hidden;
            transition: opacity .15s, visibility 0s .15s;
        }
        .placard-sp.is-loading .placard-sp__loading {
            opacity: 1; visibility: visible;
            transition: opacity .15s .15s, visibility 0s .15s;
        }
        .placard-sp__loading .spinner { display: inline-flex; margin: 0; }
        .placard-sp__placeholder .cp-icon { width: 48px; height: 48px; }
        .placard-sp__placeholder svg { width: 100%; height: 100%; fill: currentColor; }
        .placard-sp.is-empty .placard-sp__placeholder { display: flex; }
        .placard-sp.is-empty .buttons { display: none; }

        .placard-lightbox {
            background: none; box-shadow: none;
            border-radius: 6px; overflow: hidden;
        }
        /* Fits 90% of the window, capped at the card's real width so the PNG isn't upscaled. */
        .placard-lightbox > img {
            display: block; height: auto;
            aspect-ratio: var(--placard-lb-w) / var(--placard-lb-h);
            width: min(
                calc(var(--placard-lb-w) * 1px),
                90vw,
                calc(90vh * var(--placard-lb-w) / var(--placard-lb-h))
            );
        }

    </style>

    <script>
    (function () {
        document.querySelectorAll('.placard-sp').forEach(function (root) {
            if (root.dataset.wired) return;
            root.dataset.wired = '1';
            var img = root.querySelector('.placard-sp__img');
            var open = root.querySelector('.placard-sp__open');
            var style = getComputedStyle(root);
            var cardWidth = parseFloat(style.getPropertyValue('--placard-w'));
            var cardHeight = parseFloat(style.getPropertyValue('--placard-h'));

            // A background image fires no load event, so a copy reports when it's ready.
            // `data-loading` names the image awaited, so a later swap's spinner outlasts this one.
            var first = root.dataset.loading = img.dataset.url;
            var loader = new Image();
            loader.onload = loader.onerror = function () {
                if (root.dataset.loading === first) root.classList.remove('is-loading');
            };
            loader.src = first;

            // Plain Garnish.Modal, as Craft.PreviewFileModal needs an asset id. The image sizes
            // itself in CSS, since Garnish clamps width and height separately and would squash it.
            open.addEventListener('click', function () {
                // `fitted` drops Craft's default modal size so it hugs the card.
                var $container = $('<div class="modal fitted placard-lightbox"/>')
                    .css({ '--placard-lb-w': cardWidth, '--placard-lb-h': cardHeight })
                    .append($('<img/>', { src: img.dataset.url, alt: '' }));

                var modal = new Garnish.Modal($container, {
                    autoShow: false,
                    onHide: function () {
                        modal.destroy();
                        $container.remove();
                        open.focus();
                    },
                });

                modal.show();
            });
        });
    })();
    </script>
{% else %}
    <p class="light">{{ 'Save the entry to preview how it will appear when shared.'|t('placard') }}</p>
{% endif %}
