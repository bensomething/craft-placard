{#
    Share preview.

    Deliberately *not* a mock-up of any platform's card. Every consumer of an
    og:image crops it to its own box — and not one box per platform either: feed vs.
    compact card, mobile vs. desktop, and Slack / WhatsApp / iMessage are tighter
    than any of them. Chasing per-platform fidelity means maintaining a lookup table
    of other people's CSS that goes stale the moment one of them redesigns.

    So this shows the one thing that is stable and actionable: the card at its real
    aspect ratio, and — on demand — the safe area every crop keeps. Lay the elements
    out inside that and they survive everywhere. The safe area is switched on by
    adding `is-showing-safe` to `.placard-sp`; the settings page's lightswitch
    does that. The entry editor shows the card alone.

    Params:
      imageUrl      Explicit image URL to frame (used by the settings-page sample).
      entry         An entry to resolve the share image from, when imageUrl is absent.
      maxWidth      Widest the preview gets, in px. Defaults to 480, which suits the
                    entry editor's field column; false lets it fill its container.
#}
{% set imageUrl = imageUrl ?? (entry ?? null ? craft.placard.shareImageUrl(entry) : null) %}

{% if imageUrl %}
    {% set placard = craft.app.plugins.getPlugin('placard') %}
    {% set cardWidth = placard ? placard.settings.width : 1200 %}
    {% set cardHeight = placard ? placard.settings.height : 630 %}
    {# The card's own colour sits under the image, so there's no grey flash while
       the PNG loads. Colours may be configured as bare hex, hence the prefix. #}
    {% set cardBg = placard ? '#' ~ placard.settings.backgroundColor|trim('#') : '#000000' %}

    <div class="placard-sp" style="--placard-w: {{ cardWidth }}; --placard-h: {{ cardHeight }}; --placard-bg: {{ cardBg }}; --placard-max-w: {{ (maxWidth ?? 480) is same as(false) ? 'none' : (maxWidth ?? 480) ~ 'px' }}">
        {# `button-fade` + `.buttons` is Craft's own hover-to-reveal button, as on an
           asset's preview thumb, so it looks and behaves the same (it also shows on
           keyboard focus). `data-url` tracks the image actually on screen, which
           the settings page swaps out, so the lightbox opens what you're seeing. #}
        <div class="placard-sp__frame button-fade">
            <div class="placard-sp__img" data-url="{{ imageUrl }}" style="background-image:url('{{ imageUrl }}')"></div>
            <div class="placard-sp__safe" aria-hidden="true"></div>
            <div class="buttons">
                {# Not Craft's `preview-btn` class, though it's the same button: the
                   entry editor binds that class to Live Preview, so it would open
                   both. `data-icon="view"` is the same eye. #}
                <button type="button" class="btn placard-sp__open" data-icon="view">{{ 'Preview'|t('app') }}</button>
            </div>
        </div>
    </div>

    <style>
        .placard-sp {
            max-width: var(--placard-max-w, 480px);
            /* The share consensus is a 1200×630 canvas with the important content
               kept inside a central 1080×600 — 5% in on each side, 2.4% top and
               bottom. Proportional, so it holds at any configured canvas size. */
            --placard-safe-x: 5%;
            --placard-safe-y: 2.4%;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        .placard-sp__frame {
            position: relative;
            aspect-ratio: var(--placard-w) / var(--placard-h);
            border: 1px solid #d3d9e0; border-radius: 6px; overflow: hidden;
        }
        .placard-sp__img {
            position: absolute; inset: 0;
            background: var(--placard-bg, #e9ebee) center/cover no-repeat;
        }
        /* Shades the at-risk margin rather than outlining the middle, so the eye
           reads "this part might go" rather than "this is a crop mark". An outsized
           spread on the inset box fills everything around it; the frame's overflow
           clips it. Plain box-shadow, so no mask-compositing support to worry about. */
        .placard-sp__safe {
            position: absolute;
            inset: var(--placard-safe-y) var(--placard-safe-x);
            opacity: 0; transition: opacity .15s;
            box-shadow: 0 0 0 9999px rgba(0, 0, 0, .55);
            outline: 1px dashed rgba(255, 255, 255, .5);
        }
        .placard-sp.is-showing-safe .placard-sp__safe { opacity: 1; }

        .placard-lightbox {
            background: none; box-shadow: none;
            border-radius: 6px; overflow: hidden;
        }
        /* The largest card that fits 90% of the window both ways, never wider than
           its real width — past that the PNG is only being upscaled and goes
           soft. aspect-ratio keeps its shape whichever limit wins. */
        .placard-lightbox > img {
            display: block; height: auto;
            aspect-ratio: var(--placard-lb-w) / var(--placard-lb-h);
            width: min(
                calc(var(--placard-lb-w) * 1px),
                90vw,
                calc(90vh * var(--placard-lb-w) / var(--placard-lb-h))
            );
        }

    </style>

    <script>
    (function () {
        document.querySelectorAll('.placard-sp').forEach(function (root) {
            if (root.dataset.wired) return;
            root.dataset.wired = '1';
            var img = root.querySelector('.placard-sp__img');
            var open = root.querySelector('.placard-sp__open');
            var style = getComputedStyle(root);
            var cardWidth = parseFloat(style.getPropertyValue('--placard-w'));
            var cardHeight = parseFloat(style.getPropertyValue('--placard-h'));

            // Lightbox, after Craft's asset preview. Craft.PreviewFileModal only
            // takes an asset id, and the card isn't an asset, so it's a plain
            // Garnish.Modal. The image sizes itself in CSS (see .placard-lightbox)
            // and the modal wraps it: Garnish clamps width and height separately,
            // with a 200px floor on the height, so handing it a size squashes the
            // card in a short or narrow window.
            open.addEventListener('click', function () {
                // `fitted` drops Craft's default modal size (66% of the window, at
                // least 600×400), so the modal is exactly the size of the card.
                var $container = $('<div class="modal fitted placard-lightbox"/>')
                    .css({ '--placard-lb-w': cardWidth, '--placard-lb-h': cardHeight })
                    .append($('<img/>', { src: img.dataset.url, alt: '' }));

                var modal = new Garnish.Modal($container, {
                    autoShow: false,
                    onHide: function () {
                        modal.destroy();
                        $container.remove();
                        open.focus();
                    },
                });

                modal.show();
            });
        });
    })();
    </script>
{% else %}
    <p class="light">{{ 'Save the entry to preview how it will appear when shared.'|t('placard') }}</p>
{% endif %}
