{# Settings page sidebar card. Its controls are in _settings.twig. #}
<div class="placard-sidebar">
    {{ include('placard/_preview/cards', {
        imageUrl: actionUrl('placard/image/sample', { v: now|date('U') }),
        maxWidth: false,
    }, with_context = false) }}
</div>

{# Settings page only. The sidebar can't collapse (overriding Craft's remembered cookie
   state, which would hide the card with no toggle) and widens beside the content. #}
<style>
    #details-toggle-wrapper { display: none; }
    #details-container[data-state=collapsed] { display: block; }
    #details .details { padding-inline: 0; }

    @media only screen and (min-width: 60.875rem) {
        :root { --details-width: 480px; }
        #details { width: var(--details-width); }
    }

    /* Stacked, the card is already full width, so the lightbox adds nothing. */
    @media only screen and (max-width: 60.8125rem) {
        #details .placard-sp .buttons { display: none; }
    }
</style>
