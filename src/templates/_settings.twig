{# Read-only, as config lives in config/placard.php. These control the card in _sidebar.twig. #}
{% import '_includes/forms' as forms %}

{% if unknownHandles %}
    <p class="warning has-icon">
        <span class="icon" aria-hidden="true"></span>
        <span class="visually-hidden">{{ 'Warning:'|t('app') }} </span>
        <span>{{ 'These overrides don’t match a section or entry type, so they do nothing: {handles}'|t('placard', { handles: unknownHandles|map(h => "<code>#{h}</code>")|join(', ') })|raw }}</span>
    </p>
{% endif %}

<div class="placard-settings" data-sample-url="{{ actionUrl('placard/image/sample') }}">
    {% if previewOptions %}
        {# Entries are fetched when a pair is picked, not up front. #}
        <div class="field">
            <div class="heading">
                <label for="placard-preview-type">{{ 'Preview'|t('placard') }}</label>
            </div>
            <div class="input ltr placard-settings__control">
                <div class="select">
                    <select id="placard-preview-type">
                        <option value="" data-section="" data-type="">{{ 'Default'|t('placard') }}</option>
                        {% for option in previewOptions %}
                            <option data-section="{{ option.section }}" data-type="{{ option.type }}">
                                {{- option.label -}}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="select hidden">
                    <select id="placard-preview-entry" aria-label="{{ 'Entry'|t('app') }}"></select>
                </div>
                <span class="light placard-settings__caption hidden" aria-live="polite"></span>
            </div>
        </div>
    {% endif %}

    {# Hidden for now.
    {{ forms.lightswitchField({
        label: 'Show safe area'|t('placard'),
        id: 'placard-safe-area',
        instructions: 'Anything outside the shaded edge risks being cropped somewhere. Keep text and logos inside it.'|t('placard'),
    }) }}
    #}
</div>

{# A direct child of the content pane, so Craft runs it full width. Only needed
   under the Preview dropdown. #}
{% if previewOptions %}
    <hr>
{% endif %}

<h2>{{ 'Card Configuration'|t('placard') }}</h2>

{% if hasConfigFile %}
    <p>{{ 'Placard is configured in {file}. The card it produces is in the sidebar.'|t('placard', { file: '<code>config/placard.php</code>' })|raw }}</p>
{% else %}
    <p>{{ 'There’s no {file} yet, so the sidebar shows the default card. Copy {example} from the plugin to {file} to set your own colours, fonts, logo and layout.'|t('placard', { file: '<code>config/placard.php</code>', example: '<code>example.config.php</code>' })|raw }}</p>
{% endif %}

<ul class="bullets light">
    <li>{{ 'Use the <strong>Refresh</strong> button in the top right after changing the config to see the updated card in the sidebar.'|t('placard')|raw }}</li>
    <li>{{ 'Reload this page if you’ve added or renamed a section or entry type override, to update the <strong>Preview</strong> list above.'|t('placard')|raw }}</li>
    <li>{{ 'To select and preview an entry’s share image in the sidebar, add a <strong>Social Image</strong> field to its entry type.'|t('placard')|raw }}</li>
</ul>

<style>
    .placard-settings__control {
        display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    }
</style>

{% do view.registerTranslations('placard', ['No entries yet, so this is placeholder text']) %}
{% js %}
(function () {
    var root = document.querySelector('.placard-settings');
    // Rendered by _sidebar.twig.
    var card = document.querySelector('#details .placard-sp');
    if (!card) return;

    // Craft's lightswitch fires a jQuery `change` and holds its state as the `on` class.
    $('#placard-safe-area').on('change', function () {
        card.classList.toggle('is-showing-safe', $(this).hasClass('on'));
    });

    var select = document.getElementById('placard-preview-type');
    var entrySelect = document.getElementById('placard-preview-entry');
    var caption = root.querySelector('.placard-settings__caption');
    var img = card.querySelector('.placard-sp__img');
    var refresh = document.getElementById('placard-refresh');
    var base = root.dataset.sampleUrl;
    var pending = 0;
    var listing = 0;

    function selectedPair() {
        var option = select ? select.options[select.selectedIndex] : null;
        return option ? { section: option.dataset.section, type: option.dataset.type } : {};
    }

    // Preloads the PNG so the old card stays up until the new one is ready.
    function render() {
        var pair = selectedPair();
        var params = { v: Date.now() };
        if (pair.section) params.section = pair.section;
        if (pair.type) params.type = pair.type;
        if (entrySelect && entrySelect.value) params.entryId = entrySelect.value;

        var url = Craft.getUrl(base, params);
        var request = ++pending;
        var loader = new Image();
        refresh.classList.add('loading');

        loader.onload = loader.onerror = function () {
            if (request !== pending) return;
            img.style.backgroundImage = "url('" + url + "')";
            img.dataset.url = url;
            refresh.classList.remove('loading');
        };
        loader.src = url;
    }

    // The first (most recent) entry stays selected, matching the card with none chosen.
    function loadEntries() {
        var pair = selectedPair();
        var request = ++listing;
        entrySelect.innerHTML = '';
        entrySelect.parentNode.classList.add('hidden');
        caption.classList.add('hidden');

        if (!pair.section && !pair.type) {
            render();
            return;
        }

        Craft.sendActionRequest('GET', 'placard/image/sample-entries', {
            params: { section: pair.section || '', type: pair.type || '' },
        }).then(function (response) {
            if (request !== listing) return;
            var entries = response.data.entries || [];

            entries.forEach(function (entry) {
                var option = document.createElement('option');
                option.value = entry.id;
                option.textContent = entry.title;
                entrySelect.appendChild(option);
            });

            if (entries.length) {
                entrySelect.parentNode.classList.remove('hidden');
            } else {
                caption.textContent = Craft.t('placard', 'No entries yet, so this is placeholder text');
                caption.classList.remove('hidden');
            }
            render();
        }).catch(function () {
            if (request === listing) render();
        });
    }

    refresh.addEventListener('click', render);
    if (select) select.addEventListener('change', loadEntries);
    if (entrySelect) entrySelect.addEventListener('change', render);
})();
{% endjs %}
