{
    "name": "bensomething/craft-placard",
    "description": "Open Graph images for every entry, made on your own server. No Chrome, no external service.",
    "type": "craft-plugin",
    "license": "MIT",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "open graph",
        "og image",
        "social image",
        "share image",
        "social card",
        "twitter card",
        "seo",
        "imagick"
    ],
    "support": {
        "issues": "https://github.com/bensomething/craft-placard/issues",
        "source": "https://github.com/bensomething/craft-placard"
    },
    "require": {
        "php": "^8.2",
        "ext-imagick": "*",
        "craftcms/cms": "^5.10"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1",
        "nystudio107/craft-seomatic": "^5.0",
        "vaersaagod/seomate": "^3.0",
        "yiisoft/yii2-composer": "^2.0.10"
    },
    "autoload": {
        "psr-4": {
            "bensomething\\placard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "bensomething\\placard\\tests\\": "tests/"
        }
    },
    "extra": {
        "handle": "placard",
        "name": "Placard",
        "developer": "Ben Smith",
        "developerUrl": "https://bensomething.com",
        "documentationUrl": "https://github.com/bensomething/craft-placard",
        "changelogUrl": "https://raw.githubusercontent.com/bensomething/craft-placard/develop/CHANGELOG.md",
        "class": "bensomething\\placard\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G",
        "test": "phpunit"
    }
}
